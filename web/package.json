{
  "name": "blobb",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run verify && node build.mjs",
    "dev": "node build.mjs --dev --watch",
    "serve": "node serve.mjs",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "lint": "eslint src test",
    "verify": "npm run check && npm run lint && npm test",
    "eval": "esbuild tools/eval.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/eval.mjs && node node_modules/.cache/eval.mjs",
    "curriculum": "esbuild tools/curriculum.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/curriculum.mjs && node node_modules/.cache/curriculum.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.85",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "description": "An old wizard, a spellbook, and a blob from another dimension that learns to run your errands."
}
